# ── Configuración de la API ──────────────────────────────────────────────────
# Ruta o URL del backend, incluyendo /api.
#
# Déjalo en `/api`: el navegador lo resuelve contra el host desde el que cargó la
# página y el proxy de Vite lo reenvía a http://localhost:5218. Funciona igual en
# localhost y al servir con `vite --host` desde otro dispositivo de la red.
#
# Solo cámbialo a una URL absoluta si el backend no está detrás del proxy de Vite.
VITE_API_URL=/api

# ── Proveedores de inicio de sesión externos ─────────────────────────────────
# Ocultan los botones "Continuar con Google" / "Continuar con GitHub" en las
# pantallas de login y registro. Por defecto `true` (se muestran, si además el
# backend los tiene habilitados).
#
# Ponlos en `false` al servir con `npm run dev:lan` para probar desde otro
# dispositivo de la red: el callback de Google solo puede volver a `localhost` o
# a un dominio público https, así que desde un móvil el flujo termina en
# "localhost rechazó la conexión". Con los botones ocultos, el acceso desde la
# LAN se hace con las credenciales locales (email y contraseña).
#
# Es solo una máscara de interfaz: quien decide de verdad qué proveedores
# aceptar es el backend (OAuth:*:Enabled). Esta variable puede ocultar uno
# habilitado, nunca habilitar uno apagado.
VITE_ENABLE_GOOGLE_AUTH=true
VITE_ENABLE_GITHUB_AUTH=true
